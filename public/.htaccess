# Single-page-app fallback for Hostinger (Apache).
# Real files/folders are served as-is; every other path (e.g. /admin) is
# handed to index.html so React Router-style client routing works.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache the hashed build assets; never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|jpg|jpeg|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
